{
  "version": 2,
  "builds": [{ "src": "ui-ux-demo/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/", "dest": "/ui-ux-demo/index.html" },
    { "src": "/(.*)", "dest": "/ui-ux-demo/$1" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
